generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  links       String[]     @default([])
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  category  String?
  level     String?
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Experience {
  id           String   @id @default(cuid())
  company      String
  position     String
  period       String
  achievements String[]
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String
  url         String?
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
